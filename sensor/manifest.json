{
  "manifest_version": 3,
  "name": "Usual Install",
  "version": "0.1.0",
  "description": "Installs Linux applications from vendor download pages using your package manager.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
