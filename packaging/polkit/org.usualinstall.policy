<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Usual Install</vendor>
  <vendor_url>https://github.com/jackofalltrades101/usual-install</vendor_url>

  <!--
    One narrow action. The caller may ask to install a package that the signed
    catalogue lists and whose own distro metadata names the vendor's domain;
    it cannot ask for an arbitrary package. auth_admin_keep means a desktop
    user authenticates once and is not prompted again for the rest of the
    session, which is what keeps the flow feeling like an installer rather
    than a sudo prompt.
  -->
  <action id="org.usualinstall.install">
    <description>Install an application from your distribution's repositories</description>
    <message>Authentication is required to install an application</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!--
    Installing a package built from an AUR build script. That script was
    written by a community member, not the distribution, so this asks for a
    password every time and is never remembered for the session: the same
    moment of consent as the UAC prompt a Windows installer shows.
  -->
  <action id="org.usualinstall.install-aur">
    <description>Install an application built from the AUR</description>
    <message>Authentication is required to install an application built from a community (AUR) build script</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.usualinstall.configure">
    <description>Change Usual Install settings</description>
    <message>Authentication is required to change Usual Install settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
