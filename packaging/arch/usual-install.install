post_install() {
  # Installing this package is the request to run it.
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable --now usuald.service usual-install-update.timer 2>/dev/null \
    || systemctl enable usuald.service usual-install-update.timer 2>/dev/null || true
  # Flatpak browsers, once, for every user (each done as that user).
  usual-provision flatpak --all-users >/dev/null 2>&1 || true
  echo
  echo "Usual Install is running. Restart your browser and visit a download page."
  echo "Installed a browser later? Run: usualctl refresh"
  echo
  echo "To turn it off: systemctl disable --now usuald.service"
  echo
}

post_upgrade() {
  systemctl daemon-reload 2>/dev/null || true
  systemctl try-restart usuald.service 2>/dev/null || true
}

pre_remove() {
  systemctl disable --now usuald.service 2>/dev/null || true
  systemctl disable --now usual-install-update.timer 2>/dev/null || true
}
