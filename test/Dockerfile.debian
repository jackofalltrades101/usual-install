# Debian test environment -- the fast dev loop.
#
# Arch is the Phase 1 target, but `archlinux` publishes x86_64 images only, so
# on an Apple Silicon host it runs under QEMU emulation, where Chromium aborts.
# This image is architecture-native everywhere, so tier 2 (sensor loads,
# download intercepted, agent reached) actually runs.
#
# Use this while developing; use test/Dockerfile to verify on the real target.
#
#   docker build -t usual-install-debian -f test/Dockerfile.debian .
#   docker run --rm usual-install-debian
#   docker run --rm --user root usual-install-debian   # also does tier 2c (/etc/hosts)
FROM debian:stable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium python3 python3-gi gir1.2-gtk-4.0 xvfb xauth make \
      openssl ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash tester
WORKDIR /src
COPY . /src
RUN chown -R tester:tester /src
USER tester

ENV USUAL_DRY_RUN=1
ENTRYPOINT ["/bin/bash", "test/run.sh"]
