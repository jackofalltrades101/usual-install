#!/usr/bin/env -S python3 -B
"""usual-session -- native messaging host.

Spawned by the browser as the logged-in user. Resolves the page the user is on
against the local catalogue and, when it resolves, hands off to the installer
window and tells the sensor to drop the download.

Phase 1 is rootless: Flathub only, `flatpak --user`, no daemon, no polkit.
Phase 2 moves resolution and privileged installs behind usuald over DBus; this
file then shrinks to a transport.

Protocol: 4-byte native-endian length prefix, then UTF-8 JSON, both directions.
"""
import json, os, pathlib, struct, subprocess, sys, time

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "resolver"))
sys.path.insert(0, str(HERE.parent / "compat"))
sys.path.insert(0, str(HERE.parent / "catalogue"))
sys.path.insert(0, str(HERE.parent / "daemon"))
from resolve import resolve, looks_installable, looks_windows  # noqa: E402
from match import match as compat_match  # noqa: E402
from runners import detect_host, choose_runner  # noqa: E402
from sign import verify as verify_signature  # noqa: E402
import client as daemon_client  # noqa: E402

CATALOGUE_PATHS = [
    os.environ.get("USUAL_CATALOGUE"),
    str(HERE.parent / "catalogue" / "catalogue.json"),
    "/usr/share/usual-install/catalogue.json",
    os.path.expanduser("~/.local/share/usual-install/catalogue.json"),
]
COMPAT_PATHS = [
    os.environ.get("USUAL_COMPAT"),
    str(HERE.parent / "compat" / "compat.json"),
    "/usr/share/usual-install/compat.json",
    os.path.expanduser("~/.local/share/usual-install/compat.json"),
]
LOG = pathlib.Path(os.environ.get(
    "USUAL_LOG", os.path.expanduser("~/.cache/usual-install/session.log")))
INSTALLER = HERE / "installer.py"


def log(msg):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except OSError:
        pass


def read_message():
    header = sys.stdin.buffer.read(4)
    if len(header) < 4:
        return None
    (length,) = struct.unpack("@I", header)
    if length == 0 or length > 4 * 1024 * 1024:
        return None
    body = sys.stdin.buffer.read(length)
    if len(body) < length:
        return None
    return json.loads(body.decode("utf-8"))


def write_message(obj):
    body = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("@I", len(body)))
    sys.stdout.buffer.write(body)
    sys.stdout.buffer.flush()


ALLOW_UNSIGNED = os.environ.get("USUAL_ALLOW_UNSIGNED") == "1"


def load_signed(paths, empty, label):
    """Load the first readable catalogue whose signature verifies.

    The catalogue decides what gets installed, so an unverified one is not
    merely suspect, it is the whole attack. A failure here is fatal to the
    feature, never a silent downgrade: we fall back to an empty catalogue,
    which makes every download a no-op.
    """
    for p in paths:
        if not p:
            continue
        path = pathlib.Path(p)
        if not path.is_file():
            continue
        ok, why = verify_signature(path)
        if not ok:
            if not ALLOW_UNSIGNED:
                log(f"REFUSING {label} {path}: {why}")
                continue
            log(f"{label} {path} UNVERIFIED ({why}) — allowed by USUAL_ALLOW_UNSIGNED")
        with path.open() as f:
            cat = json.load(f)
        log(f"{label} {path} generated={cat.get('generated')} verified={ok}")
        return cat
    log(f"no usable {label}; affected downloads will be ignored")
    return empty


def load_catalogue():
    return load_signed(CATALOGUE_PATHS,
                       {"hosts": {}, "domains": {}, "max_candidates": 8},
                       "catalogue")


def load_compat():
    return load_signed(COMPAT_PATHS, {"entries": []}, "compat")


def launch_installer(payload_obj):
    """Detached, so the browser's native-messaging pipe is never held open by UI."""
    payload = json.dumps(payload_obj)
    try:
        subprocess.Popen(
            [sys.executable, str(INSTALLER), "--payload", payload],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return True
    except OSError as e:
        log(f"installer launch failed: {e}")
        return False


def host_of(url):
    try:
        from urllib.parse import urlparse
        return (urlparse(url).hostname or "").lower()
    except Exception:
        return ""


def decide_compat(msg, compat):
    """A Windows installer: can it run acceptably here, and how?

    Returns a reply dict. The download is never cancelled on this path -- the
    .exe is the thing that gets run, so it has to finish downloading.
    """
    page_url = msg.get("pageUrl") or ""
    entry, why = compat_match(compat,
                              page_title=msg.get("pageTitle") or "",
                              filename=msg.get("filename") or "",
                              host=host_of(page_url))
    if not entry:
        # We could not even identify the product. Say nothing; the plain
        # download proceeds as it would without Usual Install installed.
        log(f"compat: no match [{why}]")
        return {"action": "ignore", "reason": why}

    plan, plan_why = choose_runner(entry, detect_host())
    if not plan:
        # We know what this is and that it will not run well. Say so plainly,
        # and still let the download through -- the user may have their own plan.
        log(f"compat: {entry['name']} unsupported [{plan_why}]")
        launch_installer({"mode": "unsupported", "pageUrl": page_url,
                          "compat": {"entry": entry, "reason": plan_why}})
        return {"action": "ignore", "reason": f"{entry['name']}: {plan_why}"}

    log(f"compat: {entry['name']} via {plan['runner']} [{plan_why}]")
    return {"action": "compat", "reason": plan_why, "app": entry["name"]}


def handle(msg, catalogue, compat):
    kind = msg.get("type")

    # Second phase of the compatibility path: the .exe has finished downloading.
    if kind == "downloaded":
        path = msg.get("path") or ""
        entry, why = compat_match(compat,
                                  page_title=msg.get("pageTitle") or "",
                                  filename=pathlib.Path(path).name,
                                  host=host_of(msg.get("pageUrl") or ""))
        if not entry:
            return {"action": "ignore", "reason": why}
        plan, plan_why = choose_runner(entry, detect_host())
        if not plan:
            return {"action": "ignore", "reason": plan_why}
        ok = launch_installer({"mode": "compat", "pageUrl": msg.get("pageUrl") or "",
                               "exePath": path,
                               "compat": {"entry": entry, "plan": plan, "reason": plan_why}})
        return {"action": "handled" if ok else "ignore", "reason": plan_why}

    if kind != "download":
        return {"action": "ignore", "reason": "unknown message type"}

    page_url = msg.get("pageUrl") or ""
    filename = msg.get("filename") or ""
    download_url = msg.get("downloadUrl") or ""

    # A Windows installer means there is no Linux build on this page.
    if looks_windows(filename, download_url):
        return decide_compat(msg, compat)

    if not looks_installable(filename, download_url):
        return {"action": "ignore", "reason": "not an installer-shaped download"}

    # Prefer the daemon: it owns the system catalogue and is the only copy a
    # user cannot quietly edit. Falling back keeps Phase 1 behaviour working on
    # a machine where usuald is not installed.
    candidates, reason = [], ""
    try:
        done, _ = daemon_client.call("resolve", pageUrl=page_url)
        candidates = done.get("candidates") or []
        reason = (done.get("reason") or "") + " (usuald)"
    except daemon_client.DaemonUnavailable:
        candidates, reason = resolve(page_url, catalogue)
    except Exception as e:
        log(f"daemon resolve failed ({e!r}); using the local catalogue")
        candidates, reason = resolve(page_url, catalogue)
    log(f"{page_url} -> {len(candidates)} candidate(s) [{reason}]")
    if not candidates:
        return {"action": "ignore", "reason": reason}

    if not launch_installer({"mode": "native", "candidates": candidates,
                             "pageUrl": page_url,
                             "domain": host_of(page_url)}):
        return {"action": "ignore", "reason": "installer unavailable"}

    return {
        "action": "handled",
        "reason": reason,
        "candidates": [c["id"] for c in candidates],
    }


def main():
    catalogue = load_catalogue()
    compat = load_compat()
    while True:
        try:
            msg = read_message()
        except (ValueError, struct.error) as e:
            log(f"bad message: {e}")
            return
        if msg is None:
            return
        try:
            reply = handle(msg, catalogue, compat)
        except Exception as e:  # never hang a download because we crashed
            log(f"handler error: {e!r}")
            reply = {"action": "ignore", "reason": "internal error"}
        write_message(reply)


if __name__ == "__main__":
    main()
